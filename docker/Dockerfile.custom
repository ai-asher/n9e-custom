# Multi-stage build for N9e v8.5.1 + custom denoise/suppress/mute extensions.
#
# Build context expectation: project root (so the COPY commands see go.mod,
# alert/, internal/custom/, etc/, integrations/, front/).
#
# Image stack: golang:1.24-alpine -> alpine:latest. Both are small AND we
# verified they are present in the local Docker cache, so the build works
# even when Docker Hub is unreachable.
#
# Output: a slim image running ./n9e listening on :17000 (HTTP) and :20090
# (alert engine HTTP). Runtime config is mounted at /app/etc.

ARG GO_VERSION=1.24
FROM golang:${GO_VERSION}-alpine AS builder

# Tools the build genuinely needs:
#   git: go mod resolve for some dependencies that prefer git protocol
#   ca-certificates: HTTPS to proxy.golang.org (skipped at build time if
#     deps are already in module cache, but harmless to install)
RUN apk add --no-cache git ca-certificates

ENV CGO_ENABLED=0 \
    GOOS=linux \
    GOFLAGS=-mod=mod

WORKDIR /src

# Cache the dependency layer separately from the source — module deps
# change rarely, source changes constantly.
COPY go.mod go.sum ./
RUN go mod download

# Source.
COPY . .

# Strip debug info to keep the binary lean; verbose linker output stays
# off the critical path. Main entry is cmd/center (the all-in-one center
# binary that also runs the alert engine when configured).
RUN go build -trimpath -ldflags='-s -w' -o /out/n9e ./cmd/center/

# ---

FROM alpine:latest AS runtime

# tzdata: N9e + cron mute work in IANA timezones (Asia/Shanghai by default).
# ca-certificates: outbound notifications (DingTalk / Feishu / Webhook) over HTTPS.
RUN apk add --no-cache tzdata ca-certificates \
    && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone

WORKDIR /app

# Binary + side-files needed at runtime. We deliberately do NOT bake the
# config.toml into the image — operators mount /app/etc to swap configs
# without rebuilding.
COPY --from=builder /out/n9e /app/n9e
COPY etc /app/etc
COPY integrations /app/integrations
COPY front /app/front

ENV TZ=Asia/Shanghai \
    GIN_MODE=release

EXPOSE 17000 20090

# Default command runs the all-in-one center+alert process. Compose may
# override to point at a different config file via -conf flag.
CMD ["/app/n9e", "-configs", "/app/etc"]
